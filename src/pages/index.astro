---

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Where's Wondercat? A little site about finding Wondercat." />
		<title>Where's Wondercat?</title>
	</head>
	<body>
		<main>
			<header>
				<p class="eyebrow">wondercat.co.uk</p>
				<h1>Where&rsquo;s Wondercat?</h1>
				<p class="lede">A tiny corner of the internet. Coming soon.</p>
			</header>

			<section class="card">
				<h2>Status</h2>
				<p>
					The website is live and wired up for deployments. Next step: building the first real experience.
				</p>
				<div class="meta">
					<span>GitHub: thefairyhouse/wondercat</span>
					<span>Hosting: Vercel</span>
				</div>
			</section>

			<footer>
				<p class="fine">© {new Date().getFullYear()} Wondercat</p>
			</footer>
		</main>

		<style>
			:global(html) {
				color-scheme: light;
				background: radial-gradient(1200px 800px at 15% 10%, #fff5f7 0%, #ffffff 35%, #f7fbff 100%);
				font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
					Arial, "Apple Color Emoji", "Segoe UI Emoji";
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				padding: 32px 16px;
				color: #0f172a;
			}

			main {
				width: 100%;
				max-width: 860px;
				display: grid;
				gap: 24px;
			}

			header {
				display: grid;
				gap: 10px;
			}

			.eyebrow {
				margin: 0;
				font-size: 14px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				color: #475569;
			}

			h1 {
				margin: 0;
				font-size: clamp(40px, 6vw, 64px);
				line-height: 1.05;
				letter-spacing: -0.03em;
			}

			.lede {
				margin: 0;
				font-size: 18px;
				line-height: 1.5;
				color: #334155;
			}

			.card {
				background: rgba(255, 255, 255, 0.75);
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 18px;
				padding: 20px;
				box-shadow:
					0 1px 1px rgba(15, 23, 42, 0.05),
					0 18px 40px rgba(15, 23, 42, 0.08);
				backdrop-filter: blur(10px);
			}

			.card h2 {
				margin: 0 0 10px 0;
				font-size: 18px;
				letter-spacing: -0.01em;
			}

			.card p {
				margin: 0;
				color: #334155;
				line-height: 1.6;
			}

			.meta {
				margin-top: 14px;
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				color: #475569;
				font-size: 14px;
			}

			.meta span {
				padding: 6px 10px;
				border-radius: 999px;
				background: rgba(15, 23, 42, 0.05);
				border: 1px solid rgba(15, 23, 42, 0.06);
			}

			footer {
				padding-top: 8px;
			}

			.fine {
				margin: 0;
				font-size: 13px;
				color: #64748b;
			}
		</style>
	</body>
</html>
